# =============================================================================
#  VORLAGE FÜR DIE LOKALE .env
# =============================================================================
#
#  So benutzt du diese Datei:
#    1. Kopiere sie:  cp .env.example .env
#    2. Trage unten deine Werte ein.
#    3. Die .env bleibt AUSSCHLIESSLICH auf deinem Rechner.
#
#  Die .env ist in .gitignore eingetragen und landet niemals im Repository.
#  Diese Vorlage hier enthält bewusst KEINE echten Werte.
#
#  Gebraucht wird das nur für den Gesamtexport nach der Feier:
#    npm run export-erinnerungen
#
#  Die Website selbst braucht davon NICHTS. Sie kommt mit dem öffentlichen
#  Anon-Key aus config/party-config.js aus.
# =============================================================================


# Die Projekt-Adresse. Steht in Supabase unter:
#   Project Settings -> API -> Project URL
# Ohne Eintrag wird die Adresse aus config/party-config.js verwendet.
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# ACHTUNG: Der service_role-Key umgeht ALLE Sicherheitsregeln.
# Er gehört NIEMALS ins Frontend, NIEMALS ins Repository und NIEMALS in eine
# Nachricht. Er wird ausschließlich hier lokal für den Export gebraucht.
# Zu finden in Supabase unter:
#   Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Nur ändern, wenn der private Speicher anders heißt als in der Konfiguration.
SUPABASE_MEMORIES_BUCKET=private-memories
